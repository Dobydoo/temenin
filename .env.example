# Temenin env. Copy to .env.local. All optional: without keys the app runs
# fully on the deterministic local fallback (see README "AI calls").
# Live Meta Model API endpoint + key (enables /api/ai/* live calls)
# Chat Completions endpoint, e.g. https://api.meta.ai/v1/chat/completions
META_MODEL_URL=
META_MODEL_API_KEY=
# Optional model id (default: muse-spark-1.3). Use a hosted id such as
# muse-spark-1.3 or muse-wonder-1.0; the bare "muse-spark" alias is retired.
META_MODEL_NAME=muse-spark-1.3
# Optional: MOCK_AI=true returns {source:"fallback", mock:true} so no AI badge
# ever shows without a real model
MOCK_AI=
